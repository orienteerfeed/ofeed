# Ordinary GitHub development; repository administration stays restricted.
prefix_rule(pattern = ["gh", "pr", ["list", "view", "status", "checks", "diff", "create", "edit", "ready", "checkout", "update-branch"]], decision = "allow")
prefix_rule(pattern = ["gh", "issue", ["list", "view", "status", "create", "edit"]], decision = "allow")
prefix_rule(pattern = ["gh", "project", ["list", "view", "item-list"]], decision = "allow")
prefix_rule(pattern = ["gh", "run", ["list", "view", "watch", "download"]], decision = "allow")
prefix_rule(pattern = ["gh", "workflow", ["list", "view"]], decision = "allow")
prefix_rule(pattern = ["gh", "repo", ["list", "view"]], decision = "allow")
prefix_rule(pattern = ["gh", "auth", "status"], decision = "allow")
prefix_rule(pattern = ["gh", "search"], decision = "allow")
prefix_rule(pattern = ["gh", "status"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", ["merge", "review", "close", "reopen", "comment", "lock", "unlock"]], decision = "prompt")
prefix_rule(pattern = ["gh", "issue", ["close", "reopen", "comment", "delete", "transfer", "lock", "unlock", "pin", "unpin"]], decision = "prompt")
prefix_rule(pattern = ["gh", "project", ["item-edit", "item-archive"]], decision = "prompt")
prefix_rule(pattern = ["gh", "workflow", ["run", "enable", "disable"]], decision = "prompt")
prefix_rule(pattern = ["gh", "run", ["rerun", "cancel", "delete"]], decision = "prompt")
prefix_rule(pattern = ["gh", "api"], decision = "prompt")
prefix_rule(pattern = ["gh", "repo", ["create", "delete", "edit", "fork", "clone", "rename", "sync", "archive", "unarchive"]], decision = "forbidden", justification = "Repository administration is outside the development workflow.")
prefix_rule(pattern = ["gh", ["release", "secret", "variable", "ruleset"]], decision = "forbidden", justification = "Do not publish releases or change repository security/configuration.")
