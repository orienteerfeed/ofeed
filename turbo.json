{
  "$schema": "https://v2-9-5.turborepo.dev/schema.json",
  "envMode": "strict",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "API_BASE_URL",
    "DATABASE_URL",
    "ACCESS_JWT_KEY_FILE",
    "ACCESS_JWT_ISSUER",
    "ACCESS_JWT_AUDIENCE",
    "CLIENT_APP_URL",
    "CORS_ORIGIN",
    "CORS_METHODS",
    "CORS_HEADERS",
    "RATE_LIMIT_WINDOW_MS",
    "RATE_LIMIT_MAX",
    "VITE_BASE_URL",
    "VITE_API_BASE_URL",
    "VITE_OFEED_API_URL",
    "VITE_OFEED_GQL_WS_URL",
    "VITE_OFEED_PROXY_TARGET",
    "VITE_PROVIDERS",
    "VITE_PUBLIC_URL",
    "VITE_BOARD_APP_URL",
    "VITE_DEBUG_LOGGING",
    "VITE_DEFAULT_LANGUAGE"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:win": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    },
    "test": {
      "env": ["PUNCH_TEST_DATABASE_URL", "SESSION_TEST_DATABASE_URL"],
      "dependsOn": ["^build", "^test"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
