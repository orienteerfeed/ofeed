{
  "name": "ofeed-server",
  "version": "0.0.0",
  "description": "Orienteering Cloud Data Hub",
  "private": true,
  "type": "module",
  "scripts": {
    "build:shared": "pnpm --filter @repo/shared build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "pnpm run build:shared && pnpm run clean",
    "prestart": "pnpm run build:shared",
    "prestart:dev": "pnpm run build:shared && pnpm run db:generate",
    "prestart:dev:win": "pnpm run build:shared && pnpm run db:generate",
    "prestart:dist": "pnpm run build:shared",
    "predev": "pnpm run build:shared && pnpm run db:generate",
    "predev:win": "pnpm run build:shared && pnpm run db:generate",
    "start:dev": "NODE_ENV=development PORT=3001 tsx watch src/index.ts",
    "start:dev:win": "tsx watch src/index.ts",
    "dev": "NODE_ENV=development PORT=3001 tsx watch src/index.ts",
    "dev:win": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/views', 'dist/views', { recursive: true })\"",
    "pretype-check": "pnpm run db:generate",
    "type-check": "tsc --noEmit",
    "pretype-check:graphql": "pnpm run db:generate",
    "type-check:graphql": "tsc -p tsconfig.graphql.json --noEmit",
    "start": "pnpm exec tsx src/index.ts",
    "start:dist": "node dist/index.js",
    "start:prod": "pnpm exec prisma migrate deploy && pnpm exec prisma generate && pnpm run db:seed && node dist/index.js",
    "format": "prettier --write \"src/**/*.ts\" README.md",
    "format:check": "prettier --check \"src/**/*.ts\" README.md",
    "prettier": "prettier --write \"src/**/*.ts\" README.md",
    "pretest": "pnpm run db:generate",
    "pretest:watch": "pnpm run db:generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings=0 --no-inline-config",
    "lint:fix": "eslint src --fix",
    "db:generate": "pnpm exec prisma generate",
    "db:migrate": "pnpm exec prisma migrate dev",
    "db:migrate:deploy": "pnpm exec prisma migrate deploy",
    "db:seed": "pnpm exec tsx prisma/seed.ts"
  },
  "author": "Martin Křivda",
  "license": "GPL-3.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@hono/node-server": "^2.0.12",
    "@hono/zod-openapi": "^1.5.1",
    "@node-oauth/oauth2-server": "^5.3.0",
    "@pothos/core": "^4.13.1",
    "@pothos/plugin-prisma": "^4.15.0",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@repo/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.11",
    "@xmldom/xmldom": "^0.9.10",
    "argon2": "^0.45.1",
    "csv-parse": "^5.6.0",
    "ejs": "^3.1.10",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.2.0",
    "graphql-yoga": "^5.21.2",
    "hono": "^4.12.32",
    "hono-rate-limiter": "^0.5.3",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "resend": "^6.18.1",
    "rotating-file-stream": "^3.2.9",
    "sharp": "^0.35.3",
    "ws": "^8.21.1",
    "xml2js": "^0.6.2",
    "xmllint-wasm": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@types/xml2js": "^0.4.14",
    "eslint": "^9.39.5",
    "prettier": "^2.8.8",
    "prisma": "^7.8.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
