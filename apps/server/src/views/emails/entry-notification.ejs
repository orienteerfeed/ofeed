<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title><%= title %></title>
  </head>
  <body style="margin: 0; padding: 0; background: #f6f6f6; color: #1f2937; font-family: Arial, sans-serif; line-height: 1.5">
    <span style="display: none; max-height: 0; overflow: hidden; opacity: 0"><%= preheader %></span>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background: #f6f6f6; padding: 24px 12px">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width: 580px; background: #ffffff; border-radius: 8px; overflow: hidden">
            <tr>
              <td style="padding: 24px 28px 8px">
                <img src="https://ofeed.live/images/logos/2025-04-11_orienteerfeed_logo_48x48px_logo_favicon.png" alt="OFeed" height="48" style="display: block" />
              </td>
            </tr>
            <tr>
              <td style="padding: 12px 28px 28px">
                <h1 style="font-size: 24px; line-height: 1.25; margin: 0 0 20px"><%= title %></h1>
                <p style="margin: 0 0 16px">Ahoj <%= recipientName %>,</p>
                <% for (const paragraph of paragraphs) { %>
                  <p style="margin: 0 0 16px"><%= paragraph %></p>
                <% } %>
                <% if (payment) { %>
                  <h2 style="font-size: 18px; line-height: 1.3; margin: 28px 0 12px"><%= payment.heading %></h2>
                  <% for (const paragraph of payment.paragraphs) { %>
                    <p style="margin: 0 0 12px"><%= paragraph %></p>
                  <% } %>
                  <% if (payment.qrCodeDataUrl) { %>
                    <p style="margin: 16px 0; text-align: center">
                      <img src="<%= payment.qrCodeDataUrl %>" width="208" height="208" alt="QR kód pro platbu" style="display: inline-block; max-width: 208px; height: auto; background: #ffffff" />
                    </p>
                  <% } %>
                  <% if (payment.details.length > 0) { %>
                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse: collapse; margin-top: 12px">
                      <% for (const detail of payment.details) { %>
                        <tr>
                          <td style="padding: 8px 12px 8px 0; border-bottom: 1px solid #e5e7eb; color: #6b7280; width: 40%"><%= detail.label %></td>
                          <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; font-weight: 600; overflow-wrap: anywhere"><%= detail.value %></td>
                        </tr>
                      <% } %>
                    </table>
                  <% } %>
                  <% if (payment.action) { %>
                    <p style="margin: 20px 0 0">
                      <a href="<%= payment.action.url %>" style="background: #2563eb; border-radius: 6px; color: #ffffff; display: inline-block; font-weight: 600; padding: 12px 18px; text-decoration: none"><%= payment.action.label %></a>
                    </p>
                  <% } %>
                <% } %>
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse: collapse; margin-top: 20px">
                  <% for (const detail of details) { %>
                    <tr>
                      <td style="padding: 8px 12px 8px 0; border-bottom: 1px solid #e5e7eb; color: #6b7280; width: 40%"><%= detail.label %></td>
                      <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; font-weight: 600"><%= detail.value %></td>
                    </tr>
                  <% } %>
                </table>
                <% if (entryDetailUrl) { %>
                  <p style="margin: 20px 0 0">
                    <a href="<%= entryDetailUrl %>" style="background: #2563eb; border-radius: 6px; color: #ffffff; display: inline-block; font-weight: 600; padding: 12px 18px; text-decoration: none">Otevřít detail přihlášky</a>
                  </p>
                  <p style="color: #6b7280; font-size: 12px; margin: 10px 0 0">Odkaz umožňuje zobrazit tuto přihlášku bez přihlášení.</p>
                <% } %>
              </td>
            </tr>
          </table>
          <p style="color: #6b7280; font-size: 12px; margin: 16px 0 0">© <%= year %> OFeed</p>
        </td>
      </tr>
    </table>
  </body>
</html>
