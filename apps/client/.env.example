# Local Vite development; Docker also accepts these names for compatibility.
# All values below are public browser configuration, never secrets.
VITE_BASE_API_URL=http://localhost:3001
VITE_PUBLIC_URL=http://localhost:3000
VITE_BOARD_APP_URL=http://localhost:5173
VITE_ENABLE_MAP_VIEW=true
VITE_DEBUG_LOGGING=false
VITE_DEFAULT_LANGUAGE=en
VITE_DOCS_URL=https://docs.orienteerfeed.com
VITE_DISCORD_INVITE_URL=https://discord.gg/QMvnurgKzU
VITE_GITHUB_REPO_URL=https://github.com/orienteerfeed/orienteerfeed

# Docker Compose / Kubernetes runtime overrides (take precedence over VITE_*).
# Set these in apps/client/.env for Compose, or web.env in Helm.
# OFEED_PUBLIC_API_URL=https://orienteerfeed.com
# OFEED_PUBLIC_URL=https://orienteerfeed.com
# OFEED_BOARD_APP_URL=https://board.orienteerfeed.com
# For local Docker Compose, the Board URL is http://localhost:3002.

PORT=8080
API_UPSTREAM=http://api:3001
