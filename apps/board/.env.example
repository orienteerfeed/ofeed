# Local Vite development; Docker also accepts these names for compatibility.
# All values below are public browser configuration, never secrets.
VITE_PROVIDERS=ofeed,liveResultat
VITE_OFEED_API_URL=/api/ofeed
# VITE_OFEED_GQL_WS_URL=/graphql
# VITE_OFEED_PROXY_TARGET=http://localhost:3001

# Docker Compose / Kubernetes runtime overrides (take precedence over VITE_*).
# Set these in apps/board/.env for Compose, or board.env in Helm.
# OFEED_BOARD_PROVIDERS=ofeed,liveResultat
# OFEED_BOARD_API_URL=/api/ofeed
# OFEED_BOARD_GQL_WS_URL=/graphql

PORT=8080
BOARD_API_UPSTREAM=http://api:3001
