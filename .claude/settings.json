      "Bash(fd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(tree:*)",
      "Bash(jq:*)",
      "Write(./apps/**)",
      "Write(./packages/**)",
      "Edit(./apps/**)",
      "Edit(./packages/**)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git remote -v)",
      "Bash(git remote show *)",
      "Bash(git worktree *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(git reset --soft *)",
      "Bash(git reset HEAD *)",
