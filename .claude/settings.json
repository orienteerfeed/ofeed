      "Bash(gh auth status *)",
      "Bash(gh label list *)",
      "Bash(gh search *)",
      "Bash(gh api *)",
      "Bash(docker compose *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker build *)",
      "Bash(docker exec *)",
      "Bash(docker inspect *)",
      "Bash(docker images *)",
      "Bash(docker image ls *)",
      "Bash(docker stats *)",
      "Bash(docker pull *)",
      "Bash(docker run *)",
      "Bash(docker stop *)",
      "Bash(docker start *)",
      "Bash(docker restart *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(pnpm prisma migrate dev:*)",
      "Bash(pnpm db:*)",
      "Bash(pnpm type-check*)",
      "Bash(pnpm --filter * exec prisma *)",
      "Bash(node *)",
      "Bash(npx vitest *)",
      "Bash(corepack *)",
      "Bash(make *)",
      "Edit(./package.json)",
      "Edit(./pnpm-workspace.yaml)",
      "Edit(./turbo.json)",
      "Edit(./docs/**)",
      "Write(./docs/**)",
      "Edit(./deploy/**)",
      "Write(./deploy/**)",
      "Edit(./.claude/hooks/**)",
      "Edit(./CHANGELOG.md)",
      "Edit(./README.md)",
      "Read(./**/.env.example*)",
      "Edit(./**/.env.example*)",
      "Write(./**/.env.example*)"
    ],
    "ask": [
      "Bash(pnpm prisma migrate deploy)",
      "Bash(pnpm prisma migrate reset:*)",
      "Bash(pnpm publish:*)",
      "Bash(npm publish:*)",
      "Write(./.github/**)",
      "Edit(./.github/**)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git tag *)",
      "Bash(gh workflow run *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method DELETE *)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down * -v*)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)",
      "Bash(docker system prune *)",
      "Bash(docker push *)"
    ],
    "deny": [
      "Bash(kubectl delete *)",
      "Bash(DROP DATABASE:*)",
      "Bash(DROP TABLE:*)",
      "Read(./secrets/**)",
      "mcp__github",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push --mirror *)",
      "Bash(git push * --delete *)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push * main)",
      "Bash(git push origin develop*)",
      "Bash(git push origin HEAD:develop*)",
      "Bash(git push * develop)",
      "Bash(git filter-branch *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git remote remove *)",
      "Bash(git config --global *)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh release *)",
      "Bash(gh ruleset *)",
      "Bash(gh auth login *)",
      "Bash(gh auth logout *)",
      "Bash(gh auth token *)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.development)",
      "Read(./**/.env.test)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.*.local)",
      "Edit(./**/.env.production)",
      "Edit(./**/.env.development)",
      "Edit(./**/.env.test)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Write(./**/.env)",
      "Write(./**/.env.local)",
      "Write(./**/.env.*.local)",
      "Write(./**/.env.production)",
      "Write(./**/.env.development)",
      "Write(./**/.env.test)",
      "Write(./**/*.pem)",
      "Write(./**/*.key)",
      "Bash(cat *.env)",
      "Bash(cat */.env)",
      "Bash(printenv*)"
    ],
    "additionalDirectories": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Branch: $(git branch --show-current 2>/dev/null). Uncommitted files: $(git status --porcelain 2>/dev/null | wc -l | tr -d ' ').\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pnpm-only.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-type-check.sh",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "env": {
    "NODE_ENV": "development",
    "DISABLE_TELEMETRY": "1"
  }
}
