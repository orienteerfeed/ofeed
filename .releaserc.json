{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "./scripts/release/analyzer.mjs",
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false
      }
    ],
    "./scripts/release/delivery-plugin.mjs"
  ]
}
